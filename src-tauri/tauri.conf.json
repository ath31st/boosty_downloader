{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boosty_downloader_gui",
  "version": "0.18.0",
  "identifier": "sidim.doma.bd",
  "build": {
    "beforeDevCommand": {
      "script": "yarn dev",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "yarn build",
      "cwd": "../frontend"
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boosty Downloader",
        "width": 1200,
        "height": 830,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}